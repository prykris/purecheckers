# Database (PostgreSQL). Locally: `npm run db:up` starts one with these credentials.
# On Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/checkers"

# Auth
JWT_SECRET="CHANGE-ME-use-a-long-random-string"

# Server
PORT=3001
NODE_ENV=production

# Public URL (used for QR codes / invite links)
SITE_URL="https://purecheckers.com"
