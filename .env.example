# Database (PostgreSQL). Locally: `npm run db:up` starts one with these credentials.
# On Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/checkers"

# Auth
JWT_SECRET="CHANGE-ME-use-a-long-random-string"

# Server
PORT=3001
CLIENT_PORT=5173
# Leave NODE_ENV unset for local development/builds; npm start sets production.
# socket for direct/local hosting; railway only behind Railway's HTTP edge.
# See docs/deployment.md before enabling header-based client identity.
CLIENT_IP_SOURCE=socket

# Public URL (used for QR codes / invite links)
SITE_URL="http://localhost:5173"
# For phone testing, use this computer's LAN address instead of localhost.
# Production: set NODE_ENV=production and SITE_URL to the public HTTPS origin.
# Local production build: set SITE_URL and ORIGIN to http://localhost:3001.
