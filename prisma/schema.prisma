generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  email          String?   @unique
  passwordHash   String?
  isGuest        Boolean   @default(false)
  isBot          Boolean   @default(false)
  profilePublic  Boolean   @default(true)
  profileVersion Int       @default(0)
  botKey         String?   @unique
  isAdmin        Boolean   @default(false)
  guestExpiresAt DateTime?
  guestRetiredAt DateTime?
  elo            Int       @default(1000)
  coins          Int       @default(0)
  gamesPlayed    Int       @default(0)
  wins           Int       @default(0)
  losses         Int       @default(0)
  friendCode     String    @unique
  lastDailyWin   DateTime?
  peakElo        Int       @default(1000)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  gamesAsRed       Game[]            @relation("RedPlayer")
  gamesAsBlack     Game[]            @relation("BlackPlayer")
  inventory        Inventory[]
  sentRequests     Friendship[]      @relation("FriendRequester")
  receivedRequests Friendship[]      @relation("FriendReceiver")
  sentTips         CoinTransaction[] @relation("TipSender")
  receivedTips     CoinTransaction[] @relation("TipReceiver")
  pendingPayouts   PendingPayout[]
  puzzleAttempts   PuzzleAttempt[]
  walletOperations WalletOperation[]
  friendshipOperations FriendshipOperation[]
  adminOperations AdminOperation[] @relation("AdminActor")
  adminAdjustments AdminOperation[] @relation("AdminTarget")
  settlementJobsAsRed GameSettlementJob[] @relation("SettlementRed")
  settlementJobsAsBlack GameSettlementJob[] @relation("SettlementBlack")
  gameRunsAsRed GameRun[] @relation("RunRed")
  gameRunsAsBlack GameRun[] @relation("RunBlack")
  activeGamePlayer ActiveGamePlayer?
  activeRoomMember ActiveRoomMember?
  createdRooms RoomRecord[]
  sessionNotices SessionNotice[]
  activeResultViewer ActiveResultViewer?

  @@index([isGuest, guestRetiredAt, id])
}

// Immutable transition notices. Dismissal is retained so retries cannot revive it.
model SessionNotice {
  id String @id @default(uuid())
  sequence BigInt @unique @default(autoincrement())
  userId Int
  effectKey String
  reason String
  context Json
  occurredAt DateTime @default(now())
  dismissedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, effectKey])
  @@index([userId, sequence(sort: Desc)])
}

// Successful owner commands and immutable receipts, committed with their effects.
model WalletOperation {
  id        Int      @id @default(autoincrement())
  userId    Int
  key       String
  kind      String
  payload   Json
  receipt   Json
  burned    Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Actor-scoped administrative receipts include before/after values for audit.
model AdminOperation {
  id Int @id @default(autoincrement())
  actorId Int
  targetId Int
  key String
  kind String
  payload Json
  receipt Json
  createdAt DateTime @default(now())
  actor User @relation("AdminActor", fields: [actorId], references: [id])
  target User @relation("AdminTarget", fields: [targetId], references: [id])

  @@unique([actorId, key])
  @@index([targetId, createdAt])
}

model Game {
  id               Int        @id @default(autoincrement())
  redPlayerId      Int
  blackPlayerId    Int
  winnerId         Int?
  result           GameResult
  redEloChange     Int        @default(0)
  blackEloChange   Int        @default(0)
  redCoinsEarned   Int        @default(0)
  blackCoinsEarned Int        @default(0)
  moveHistory      Json
  mode             GameMode   @default(RANKED)
  startedAt        DateTime   @default(now())
  endedAt          DateTime?
  endReason        String?
  settlementKey    String?    @unique
  settlement       Json?

  redPlayer   User @relation("RedPlayer", fields: [redPlayerId], references: [id])
  blackPlayer User @relation("BlackPlayer", fields: [blackPlayerId], references: [id])
  settlementJob GameSettlementJob?
  run GameRun?
}

// Durable game creation and wager reservation; accepted transition storage follows.
model GameRun {
  id           Int       @id @default(autoincrement())
  key          String    @unique
  redPlayerId  Int
  blackPlayerId Int
  mode         GameMode
  buyIn        Int
  turnTime     Int
  origin       String
  initialState Json
  checkpoint   Json?
  revision     Int       @default(0)
  stateVersion Int       @default(1)
  recoveryVersion Int    @default(0)
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  closedAt     DateTime?
  replayId     Int?      @unique
  roomId       BigInt?
  resultSourceId Int?
  invitedPlayerIds Int[] @default([])

  redPlayer User @relation("RunRed", fields: [redPlayerId], references: [id])
  blackPlayer User @relation("RunBlack", fields: [blackPlayerId], references: [id])
  replay Game? @relation(fields: [replayId], references: [id])
  commands GameCommandReceipt[]
  activePlayers ActiveGamePlayer[]
  sourceRoom RoomRecord? @relation(fields: [roomId], references: [id])
  resultRecord GameResultRecord? @relation("FinishedResult")
  rematchSource GameResultRecord? @relation("ResultRematches", fields: [resultSourceId], references: [gameRunId])

  @@index([status, createdAt])
  @@index([redPlayerId])
  @@index([blackPlayerId])
  @@index([roomId])
  @@index([resultSourceId])
}

enum ResultStatus {
  OPEN
  STARTING
  REMATCHED
  CLOSED
}

model GameResultRecord {
  gameRunId Int @id
  status ResultStatus
  state Json
  stateVersion Int @default(1)
  revision Int @default(0)
  gameRun GameRun @relation("FinishedResult", fields: [gameRunId], references: [id], onDelete: Cascade)
  rematches GameRun[] @relation("ResultRematches")
  viewers ActiveResultViewer[]
  commands GameResultCommandReceipt[]

  @@index([status, gameRunId])
}

model ActiveResultViewer {
  userId Int @id
  gameRunId Int
  role RoomMemberRole
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  result GameResultRecord @relation(fields: [gameRunId], references: [gameRunId], onDelete: Cascade)

  @@index([gameRunId])
}

model GameResultCommandReceipt {
  id Int @id @default(autoincrement())
  gameRunId Int
  userId Int
  key String
  payload Json
  revision Int
  result GameResultRecord @relation(fields: [gameRunId], references: [gameRunId], onDelete: Cascade)

  @@unique([gameRunId, userId, key])
}

enum RoomStatus {
  WAITING
  STARTING
  PLAYING
  CLOSED
}

enum RoomMemberRole {
  PLAYER
  SPECTATOR
}

// Room identity and accepted state; connection objects and QR images are derived.
model RoomRecord {
  id BigInt @id @default(autoincrement())
  creatorId Int
  creationKey String
  creation Json
  joinCode String @unique
  status RoomStatus @default(WAITING)
  state Json
  stateVersion Int @default(1)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator User @relation(fields: [creatorId], references: [id])
  members ActiveRoomMember[]
  commands RoomCommandReceipt[]
  games GameRun[]

  @@unique([creatorId, creationKey])
  @@index([status, id])
}

// Humans hold one room role. Player claims transfer atomically to a GameRun.
// Bots have no exclusive claim and can serve many rooms at the same time.
model ActiveRoomMember {
  userId Int @id
  roomId BigInt
  role RoomMemberRole
  user User @relation(fields: [userId], references: [id])
  room RoomRecord @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model RoomCommandReceipt {
  id Int @id @default(autoincrement())
  roomId BigInt
  userId Int
  key String
  payload Json
  revision Int
  createdAt DateTime @default(now())
  room RoomRecord @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId, key])
}

model GameCommandReceipt {
  id       Int @id @default(autoincrement())
  gameRunId Int
  userId   Int
  key      String
  payload  Json
  revision Int
  createdAt DateTime @default(now())
  run GameRun @relation(fields: [gameRunId], references: [id], onDelete: Cascade)

  @@unique([gameRunId, userId, key])
}

// A human may own one unfinished game seat, regardless of colour or process.
// Bots do not claim a seat here because they serve multiple games concurrently.
model ActiveGamePlayer {
  userId Int @id
  gameRunId Int
  user User @relation(fields: [userId], references: [id])
  run GameRun @relation(fields: [gameRunId], references: [id], onDelete: Cascade)

  @@index([gameRunId])
}

// One writer generation for the currently single-owner gameplay runtime.
model GameplayOwner {
  id         Int @id
  generation Int
  instanceId String
}

// Durable terminal intent. Completion is committed with the replay and payment.
model GameSettlementJob {
  key           String    @id
  redUserId     Int
  blackUserId   Int
  intent        Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  replayId      Int?      @unique

  replay Game? @relation(fields: [replayId], references: [id], onDelete: Cascade)
  redUser User @relation("SettlementRed", fields: [redUserId], references: [id])
  blackUser User @relation("SettlementBlack", fields: [blackUserId], references: [id])

  @@index([completedAt, nextAttemptAt, createdAt])
}

enum GameResult {
  RED_WIN
  BLACK_WIN
  DRAW
  ABORTED
}

enum GameMode {
  RANKED
  FRIENDLY
  BOT
}

model ShopItem {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  type      ItemType
  price     Int
  data      Json
  preview   String?
  createdAt DateTime @default(now())

  inventory Inventory[]
}

enum ItemType {
  THEME
  SKIN
  EMOTE
}

model Inventory {
  id          Int      @id @default(autoincrement())
  userId      Int
  itemId      Int
  equipped    Boolean  @default(false)
  purchasedAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id])
  item ShopItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model Friendship {
  id          Int          @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  requester User @relation("FriendRequester", fields: [requesterId], references: [id])
  receiver  User @relation("FriendReceiver", fields: [receiverId], references: [id])

  @@unique([requesterId, receiverId])
  // The migration also enforces one unordered pair and rejects self-pairs.
}

model FriendshipOperation {
  id Int @id @default(autoincrement())
  userId Int
  key String
  kind String
  payload Json
  receipt Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model CoinTransaction {
  id         Int        @id @default(autoincrement())
  senderId   Int?
  receiverId Int
  amount     Int
  reason     CoinReason
  createdAt  DateTime   @default(now())

  sender   User? @relation("TipSender", fields: [senderId], references: [id])
  receiver User  @relation("TipReceiver", fields: [receiverId], references: [id])
}

enum CoinReason {
  ADMIN_ADJUSTMENT
  STARTER_GRANT
  WAGER_STAKE
  WAGER_REFUND
  WIN_REWARD
  TIP_SENT
  TIP_RECEIVED
  PURCHASE
  PURCHASE_BURN
  BOT_WIN
  RANKED_TAX
  DAILY_BOUNTY
  ACHIEVEMENT
  VAULT_DEPOSIT
  VAULT_WITHDRAWAL
  PUZZLE_SOLVE
}

model SystemVault {
  id      Int @id @default(autoincrement())
  balance Int @default(0)
}

model PendingPayout {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  reason    CoinReason
  label     String?
  createdAt DateTime @default(now())
  claimedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}

model VaultLog {
  id        Int      @id @default(autoincrement())
  amount    Int
  direction String   // 'in' | 'out'
  reason    String
  detail    String?
  createdAt DateTime @default(now())
}


model ChatMessage {
  id         Int      @id @default(autoincrement())
  channelId  String   // "global" | "room:<id>" | "game:<id>"
  senderId   Int
  username   String   // denormalized
  content    String
  createdAt  DateTime @default(now())

  clientMessageId String?
  mentions        Int[]    @default([])
  spectator       Boolean  @default(false)

  @@unique([senderId, clientMessageId])
  @@index([channelId, id])
  @@index([senderId, channelId, id])
  @@index([channelId, createdAt])
}

// ---- Daily puzzle (docs/growth/03-daily-puzzle.md) ----

model Puzzle {
  id               Int       @id @default(autoincrement())
  date             DateTime  @unique @db.Date        // publish date, assigned at generation
  positionHash     String    @unique                 // CheckersGame._boardHash()
  position         Json                              // { board: 8x8 of {color,queen}|null, currentPlayer }
  solution         Json                              // full line: [{fromRow,fromCol,toRow,toCol,hops,captured,promoted}, ...]
  sideToMove       String                            // 'red' | 'black', denormalised for titles and queries
  difficulty       PuzzleDifficulty
  theme            String                            // primary theme key
  themes           String[]                          // extras
  solutionPlies    Int
  legalMoves       Int
  scoreGap         Float
  verifiedDepth    Int
  commentary       Json?                             // { theme, position, solution, alternatives } text blocks
  sourceGameId     Int?
  generatorVersion String
  createdAt        DateTime  @default(now())
  attempts         PuzzleAttempt[]
}

// Deliberately independent of Puzzle: deleting an unpublished puzzle must not
// erase the evidence that excludes its position from future publication.
model PuzzleRejection {
  positionHash     String   @id
  oppositeHash     String
  sourceDate       DateTime @db.Date
  verifiedDepth    Int
  reason           String
  generatorVersion String
  verifierVersion  String
  createdAt        DateTime @default(now())
}

model PuzzleAttempt {
  id        Int      @id @default(autoincrement())
  puzzleId  Int
  userId    Int?                                     // null for anonymous marketing visitors
  visitorId String?                                  // random id kept in localStorage, for solve-rate stats
  solved    Boolean
  attempts  Int
  hintUsed  Boolean  @default(false)
  revealed  Boolean  @default(false)
  timeMs    Int?
  rewarded  Boolean  @default(false)
  createdAt DateTime @default(now())

  puzzle Puzzle @relation(fields: [puzzleId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([puzzleId, userId])
  @@unique([puzzleId, visitorId])
}

enum PuzzleDifficulty {
  EASY
  MEDIUM
  HARD
}
